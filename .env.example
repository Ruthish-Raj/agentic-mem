# CLI & Server Networking
SERVER_URL="http://127.0.0.1:8000"
WS_URL="ws://127.0.0.1:8000/ws"
RULES_FILE=".agent_rules.md"

# MongoDB Atlas Connection String
# (Requires Python async driver, M0 free tier works)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/"

# Google Gemini API Key
GEMINI_API_KEY="your_google_gemini_api_key_here"

# JWT Authentication Secret Key (Generate a random string for production)
JWT_SECRET="your_jwt_secret_key_here"
